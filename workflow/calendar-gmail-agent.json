      "id": "895f63c2-fe80-4758-b11a-53dfe7537ac5",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "Look at my events/meetings for the day and identify the top two most important events.\n\nConsider the event title, description, attendees, and timing when deciding importance.\n\nThen use the Gmail tool to send me an email containing:\n\n1. The top two events\n2. Why each event is important\n\nKeep the email short and clear.\n",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
      "id": "5e6bf572-71c3-4f3c-9704-591bb8dd6d63",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "openai/gpt-oss-120b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [
        96,
        208
      ],
      "id": "daf4e3fc-7d43-4f1e-ad61-6da10a0972b5",
      "name": "Groq Chat Model"
    },
    {
      "parameters": {
        "operation": "getAll",
        "calendar": {
          "__rl": true,
          "value": "YOUR_GOOGLE_CALENDAR_ID",
          "mode": "id"
        },
        "returnAll": true,
        "timeMin": "={{ $now.startOf('day') }}",
        "timeMax": "={{ $now.plus({ days: 1 }).startOf('day') }}",
        "options": {}
      },
      "type": "n8n-nodes-base.googleCalendarTool",
      "typeVersion": 1.3,
      "position": [
        384,
        208
      ],
      "id": "06361e8a-aeed-44fd-857c-a1db51b72157",
      "name": "Get many events in Google Calendar"
    },
    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Send an email with the top two important events of the day.",
        "sendTo": "YOUR_EMAIL_ADDRESS",
        "subject": "Top 2 Important Events Today",
        "message": "AI-generated email content containing the top two most important events of the day and why each event is important.",
        "options": {}
      },
      "type": "n8n-nodes-base.gmailTool",
